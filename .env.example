# Copie para .env.local e preencha com os dados do seu projeto Supabase
# (Supabase > Project Settings > API).
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# Recomendações com IA: a chave do Gemini fica cifrada em src/services/geminiKey.ts.
# Esta é a senha que a decifra (só servidor, nunca NEXT_PUBLIC_). Para trocar a chave:
#   PLAIN_KEY=sua-chave node scripts/encrypt-key.mjs
GEMINI_KEY_SECRET=
